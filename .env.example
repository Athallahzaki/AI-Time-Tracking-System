# Backend -> engine (TCP NDJSON)
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8765
ENGINE_RECONNECT_SECONDS=2

# Path dibaca oleh proses backend
CAMERAS_CONFIG=backend/configs/cameras.yaml
POLICY_CONFIG=backend/configs/policy.yaml

# Database backend (default backend/data/backend.db)
# BACKEND_DB_PATH=backend/data/backend.db
# Retensi data deteksi per frame (kanal view), hari. Event durabel tidak dipangkas.
DETECTION_RETENTION_DAYS=7

# Kalau di-set, semua endpoint yang MENGUBAH data (kamera, enrollment, koreksi)
# butuh header X-API-Key. Proxy Vite dev menyuntikkannya dari env yang sama.
# BACKEND_API_KEY=ganti-dengan-string-acak-panjang

# Engine: berkas outbox durabel (default engine/data/outbox.sqlite3).
# JANGAN dihapus selama backend masih menyimpan last_event_seq.
# ENGINE_OUTBOX_PATH=engine/data/outbox.sqlite3

# Launcher demo: ukuran D-FINE (m | s)
# AI_TIME_DFINE=m
