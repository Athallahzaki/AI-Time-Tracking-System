{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-time-tracking/face_template.schema.json",
  "title": "Kontrak template wajah dari CCTV (paket ea-r31, 12 Nov 2026)",
  "description": "Pesan `template.*` antara backend dan engine (docs/RENCANA-TEMPLATE-WAJAH.md). Terpisah dari engine_protocol.schema.json: tidak pernah durabel, tidak masuk outbox, tidak di fixture. Semua di kanal control, permintaan-jawaban ber-request_id. Engine lama atau engine dengan face_templates.enabled: false menjawab setiap permintaan dengan `ack` ditolak (in_reply_to = tipe permintaan), dan itulah negosiasinya. PERUBAHAN KONTRAK: perlu persetujuan EA sebelum dinyalakan di pilot.",
  "oneOf": [
    {
      "$ref": "#/$defs/template_pull"
    },
    {
      "$ref": "#/$defs/template_candidates"
    },
    {
      "$ref": "#/$defs/template_apply"
    },
    {
      "$ref": "#/$defs/template_applied"
    },
    {
      "$ref": "#/$defs/template_remove"
    },
    {
      "$ref": "#/$defs/template_removed"
    }
  ],
  "$defs": {
    "_envelope": {
      "type": "object",
      "required": [
        "type",
        "v",
        "ts"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "ts": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "person_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "camera_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "similarity": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "template_pull": {
      "x-channel": "control",
      "x-direction": "backend->engine",
      "description": "Minta kandidat template yang terkumpul di buffer memori engine. Kandidat yang dikirim dihapus dari buffer.",
      "allOf": [
        {
          "$ref": "#/$defs/_envelope"
        }
      ],
      "required": [
        "request_id"
      ],
      "properties": {
        "type": {
          "const": "template.pull"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "channel": {
          "const": "control"
        }
      }
    },
    "template_candidates": {
      "x-channel": "control",
      "x-direction": "engine->backend",
      "description": "Jawaban template.pull. Hanya dari track CONFIRMED oleh wajah yang lolos gerbang tangkap engine.",
      "allOf": [
        {
          "$ref": "#/$defs/_envelope"
        }
      ],
      "required": [
        "request_id",
        "embedding_version",
        "items"
      ],
      "properties": {
        "type": {
          "const": "template.candidates"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "embedding_version": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "candidate_id",
              "person_id",
              "camera_id",
              "captured_at",
              "jpeg_b64",
              "embedding_b64",
              "anchor_similarity",
              "margin",
              "face_px",
              "det_score"
            ],
            "properties": {
              "candidate_id": {
                "$ref": "#/$defs/candidate_id"
              },
              "person_id": {
                "$ref": "#/$defs/person_id"
              },
              "camera_id": {
                "$ref": "#/$defs/camera_id"
              },
              "captured_at": {
                "type": "string",
                "minLength": 20
              },
              "track_uuid": {
                "type": "string",
                "pattern": "^tr_[A-Za-z0-9_-]{1,64}$"
              },
              "jpeg_b64": {
                "type": "string",
                "minLength": 4,
                "maxLength": 400000
              },
              "embedding_b64": {
                "type": "string",
                "minLength": 4,
                "maxLength": 20000
              },
              "anchor_similarity": {
                "$ref": "#/$defs/similarity"
              },
              "runner_up_id": {
                "$ref": "#/$defs/person_id"
              },
              "runner_up_similarity": {
                "$ref": "#/$defs/similarity"
              },
              "margin": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "face_px": {
                "type": "number",
                "minimum": 0
              },
              "det_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "yaw": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "channel": {
          "const": "control"
        }
      }
    },
    "template_apply": {
      "x-channel": "control",
      "x-direction": "backend->engine",
      "description": "Pasang kandidat yang diputuskan backend sebagai referensi source=learned. Engine memeriksa ulang setiap item terhadap roster saat itu.",
      "allOf": [
        {
          "$ref": "#/$defs/_envelope"
        }
      ],
      "required": [
        "request_id",
        "items"
      ],
      "properties": {
        "type": {
          "const": "template.apply"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "candidate_id",
              "person_id",
              "jpeg_b64",
              "embedding_b64",
              "embedding_version"
            ],
            "properties": {
              "candidate_id": {
                "$ref": "#/$defs/candidate_id"
              },
              "person_id": {
                "$ref": "#/$defs/person_id"
              },
              "jpeg_b64": {
                "type": "string",
                "minLength": 4,
                "maxLength": 400000
              },
              "embedding_b64": {
                "type": "string",
                "minLength": 4,
                "maxLength": 20000
              },
              "embedding_version": {
                "type": "string",
                "minLength": 1
              },
              "camera_id": {
                "$ref": "#/$defs/camera_id"
              },
              "captured_at": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        },
        "channel": {
          "const": "control"
        }
      }
    },
    "template_applied": {
      "x-channel": "control",
      "x-direction": "engine->backend",
      "description": "Hasil template.apply per item.",
      "allOf": [
        {
          "$ref": "#/$defs/_envelope"
        }
      ],
      "required": [
        "request_id",
        "items"
      ],
      "properties": {
        "type": {
          "const": "template.applied"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "candidate_id",
              "accepted"
            ],
            "properties": {
              "candidate_id": {
                "$ref": "#/$defs/candidate_id"
              },
              "accepted": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "maxLength": 200,
                "description": "Bila ditolak: versi_berbeda, tanpa_jangkar, jangkar_rendah, margin_tipis, duplikat, embedding_rusak, gambar_rusak."
              },
              "reference_id": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "channel": {
          "const": "control"
        }
      }
    },
    "template_remove": {
      "x-channel": "control",
      "x-direction": "backend->engine",
      "description": "Cabut referensi hasil belajar. Referensi enrollment (source=enroll) tidak pernah terhapus lewat pesan ini.",
      "allOf": [
        {
          "$ref": "#/$defs/_envelope"
        }
      ],
      "required": [
        "request_id",
        "reference_ids"
      ],
      "properties": {
        "type": {
          "const": "template.remove"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "reference_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "channel": {
          "const": "control"
        }
      }
    },
    "template_removed": {
      "x-channel": "control",
      "x-direction": "engine->backend",
      "description": "Jawaban template.remove.",
      "allOf": [
        {
          "$ref": "#/$defs/_envelope"
        }
      ],
      "required": [
        "request_id",
        "removed"
      ],
      "properties": {
        "type": {
          "const": "template.removed"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "channel": {
          "const": "control"
        }
      }
    }
  }
}
