# Salin file ini menjadi deploy/.env.mediamtx, lalu ganti nilainya.
# Gunakan substream H.264 CCTV untuk kompatibilitas browser terbaik.
CAM01_SOURCE=rtsp://username:password@192.168.1.100:554/Streaming/Channels/102

# Jika dashboard hanya dibuka di komputer server, biarkan 127.0.0.1.
# Jika dibuka dari komputer lain, isi IP LAN komputer yang menjalankan MediaMTX.
# Beberapa alamat dapat dipisahkan dengan koma: 127.0.0.1,192.168.1.20
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=127.0.0.1

