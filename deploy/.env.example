# =============================================================================
# deploy/.env — dibaca otomatis oleh `docker compose` yang dijalankan dari
# folder deploy/. Salin: cp .env.example .env
# JANGAN commit .env (berisi API key dan kredensial CCTV).
# =============================================================================

# --- Umum --------------------------------------------------------------------
COMPOSE_PROJECT_NAME=ai-time-tracking
IMAGE_PREFIX=ai-time-tracking
IMAGE_TAG=latest
TZ=Asia/Jakarta

# --- Frontend / nginx --------------------------------------------------------
# Port dashboard. HTTP_BIND=127.0.0.1 kalau hanya boleh diakses dari server.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
# Endpoint SSE yang di-bake ke bundle saat build (ubah = rebuild frontend).
VITE_API_URL=/api/detections/stream
# Batas body request (enrollment mengirim foto base64 di JSON).
CLIENT_MAX_BODY_SIZE=25m
# Folder video demo MP4 di host (relatif ke deploy/). Dimount ke /videos/.
VIDEOS_DIR=../frontend/public/videos

# --- Backend -----------------------------------------------------------------
# Hanya dipublish ke 127.0.0.1 untuk debugging.
BACKEND_PORT=8000
# Folder konfigurasi di host (relatif ke deploy/), dimount read-only.
BACKEND_CONFIG_DIR=../backend/configs
# Nama file DI DALAM folder di atas.
#   cameras.yaml          : default (MP4 lokal / sesuaikan sendiri)
#   cameras.direct.yaml   : MP4 lokal, stream_url /videos/...
#   cameras.mediamtx.yaml : CCTV via MediaMTX
#   cameras.demo.yaml     : mock
CAMERAS_CONFIG_FILE=cameras.yaml
POLICY_CONFIG_FILE=policy.yaml
DETECTION_RETENTION_DAYS=7
# Kalau di-set, endpoint yang mengubah data butuh X-API-Key. Nginx
# menyuntikkannya ke setiap request /api, jadi ini melindungi port backend
# langsung, BUKAN dashboard. Autentikasi pengguna tetap pekerjaan terbuka.
# Buat dengan: openssl rand -hex 32
BACKEND_API_KEY=

# --- Engine ------------------------------------------------------------------
# Engine asli jalan di host dan HARUS listen di 0.0.0.0 (bukan 127.0.0.1),
# kalau tidak container tidak bisa menjangkaunya:
#   python -m engine.runtime --config engine/config/dfine-m.yaml --tcp 0.0.0.0:8765
# Profile demo: ganti ENGINE_HOST=fake-engine
ENGINE_HOST=host.docker.internal
ENGINE_PORT=8765
ENGINE_RECONNECT_SECONDS=2

# --- Fake engine (profile: demo) ---------------------------------------------
# Nama skenario di engine/tools/fake_engine/scenarios (tanpa nomor/ekstensi).
FAKE_SCENARIO=happy-path
FAKE_SPEED=1

# --- MediaMTX (profile: mediamtx) --------------------------------------------
MEDIAMTX_VERSION=1.21.1
# RTSP substream H.264 CCTV asli.
CAM01_SOURCE=rtsp://username:password@192.168.1.100:554/Streaming/Channels/102
# IP LAN server, dipisah koma, agar WebRTC bisa dibuka dari PC lain.
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=127.0.0.1
# RTSP untuk engine di host. 0.0.0.0 kalau engine ada di mesin lain.
MEDIAMTX_RTSP_BIND=127.0.0.1
# Upstream nginx untuk HLS/WHEP. Default: container mediamtx di compose ini.
# Kalau MediaMTX jalan terpisah (deploy/mediamtx/), pakai:
#   http://host.docker.internal:8888 dan http://host.docker.internal:8889
MEDIAMTX_HLS_UPSTREAM=http://mediamtx:8888
MEDIAMTX_WHEP_UPSTREAM=http://mediamtx:8889
